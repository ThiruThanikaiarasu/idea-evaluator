{
  "type": "object",
  "additionalProperties": false,
  "required": ["agentId", "summary", "scores", "reasons", "personaCritiques", "overallScore"],
  "properties": {
    "agentId": { "type": "string" },
    "summary": { "type": "string", "maxLength": 900 },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "problem", "businessValue", "revenue", "competitiveGap", "differentiation", "feasibility", "needToExist", "riskReadiness", "validationReadiness"],
      "properties": {
        "audience": { "type": "number", "minimum": 0, "maximum": 10 },
        "problem": { "type": "number", "minimum": 0, "maximum": 10 },
        "businessValue": { "type": "number", "minimum": 0, "maximum": 10 },
        "revenue": { "type": "number", "minimum": 0, "maximum": 10 },
        "competitiveGap": { "type": "number", "minimum": 0, "maximum": 10 },
        "differentiation": { "type": "number", "minimum": 0, "maximum": 10 },
        "feasibility": { "type": "number", "minimum": 0, "maximum": 10 },
        "needToExist": { "type": "number", "minimum": 0, "maximum": 10 },
        "riskReadiness": { "type": "number", "minimum": 0, "maximum": 10 },
        "validationReadiness": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "problem", "businessValue", "revenue", "competitiveGap", "differentiation", "feasibility", "needToExist", "riskReadiness", "validationReadiness"],
      "properties": {
        "audience": { "type": "string", "maxLength": 300 },
        "problem": { "type": "string", "maxLength": 300 },
        "businessValue": { "type": "string", "maxLength": 300 },
        "revenue": { "type": "string", "maxLength": 300 },
        "competitiveGap": { "type": "string", "maxLength": 300 },
        "differentiation": { "type": "string", "maxLength": 300 },
        "feasibility": { "type": "string", "maxLength": 300 },
        "needToExist": { "type": "string", "maxLength": 300 },
        "riskReadiness": { "type": "string", "maxLength": 300 },
        "validationReadiness": { "type": "string", "maxLength": 300 }
      }
    },
    "personaCritiques": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail"],
        "properties": {
          "title": { "type": "string", "maxLength": 80 },
          "detail": { "type": "string", "maxLength": 360 }
        }
      }
    },
    "overallScore": { "type": "number", "minimum": 0, "maximum": 10 }
  }
}
